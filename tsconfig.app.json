{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"],
      "@loncra/antdv": ["../packages/antdv/src/index.ts"],
      "@loncra/antdv/locale/zh_CN": ["../packages/antdv/src/locale/zh_CN.ts"],
      "@loncra/antdv/locale/en_US": ["../packages/antdv/src/locale/en_US.ts"],
      "@loncra/antdv-chat": ["../packages/antdv-chat/src/index.ts"],
      "@loncra/antdv-chat/locale/zh_CN": ["../packages/antdv-chat/src/locale/zh_CN.ts"],
      "@loncra/antdv-chat/locale/en_US": ["../packages/antdv-chat/src/locale/en_US.ts"],
      "@loncra/antdv-chat-pro": ["../packages/antdv-chat-pro/src/index.ts"],
      "@loncra/antdv-chat-pro/locale/zh_CN": ["../packages/antdv-chat-pro/src/locale/zh_CN.ts"],
      "@loncra/antdv-chat-pro/locale/en_US": ["../packages/antdv-chat-pro/src/locale/en_US.ts"],
      "@loncra/chat-core": ["../packages/chat-core/src/index.ts"],
      "@loncra/chat-core/dexie": ["../packages/chat-core/src/dexie/index.ts"],
      "dexie": ["./node_modules/dexie"],
      "@loncra/antdv-pro": ["../packages/antdv-pro/src/index.ts"],
      "@loncra/antdv-pro/locale/zh_CN": ["../packages/antdv-pro/src/locale/zh_CN.ts"],
      "@loncra/antdv-pro/locale/en_US": ["../packages/antdv-pro/src/locale/en_US.ts"],
      "@loncra/client": ["../packages/client/src/index.ts"],
      "@loncra/client/commons": ["../packages/client/src/commons/index.ts"],
      "@loncra/client/auth": ["../packages/client/src/auth/index.ts"],
      "@loncra/client/resource": ["../packages/client/src/resource/index.ts"],
      "@loncra/client/message": ["../packages/client/src/message/index.ts"],
      "@loncra/client/ai": ["../packages/client/src/ai/index.ts"],
      "@loncra/client/adapters/axios": ["../packages/client/src/adapters/axios.ts"],
      "p-limit": ["./node_modules/p-limit"],
      "@codemirror/*": ["./node_modules/@codemirror/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
